# Copiá este archivo como .env.local para correr contra Firebase en tu PC.
# En GitHub estos valores salen de Settings > Secrets and variables > Actions > Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=stoica-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stoica-app
VITE_FIREBASE_STORAGE_BUCKET=stoica-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
