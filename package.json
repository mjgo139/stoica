{
  "name": "stoica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prueba": "vite --mode prueba",
    "build": "tsc -b && vite build",
    "build:prueba": "tsc -b && vite build --mode prueba",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && npm --prefix functions run typecheck",
    "test": "vitest run",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-stoica \"vitest run -c vitest.reglas.config.ts\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.0",
    "firebase": "12.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "firebase-tools": "14.27.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "2.1.8"
  }
}
