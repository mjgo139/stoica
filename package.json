{
  "name": "stoica",
  "private": true,
  "version": "2.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prueba": "vite --mode prueba",
    "build": "tsc -b && vite build",
    "build:prueba": "tsc -b && vite build --mode prueba",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && npm --prefix functions run typecheck",
    "test": "node familia/revisar.mjs && vitest run",
    "familia": "node familia/revisar.mjs",
    "iconos": "node scripts/iconos.mjs",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-stoica \"vitest run -c vitest.reglas.config.ts\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@tanstack/react-query": "5.62.0",
    "firebase": "12.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "three": "^0.170.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "firebase-tools": "14.27.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "2.1.8",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
