<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa: tarjeta de hábito. -->
<!-- Widget "tarjeta": la misma tarjeta de hábito de la app, con su semana. --><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_fondo" android:orientation="vertical" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

        <FrameLayout android:id="@+id/c_circulo" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/circulo_coraje">

            <ImageView android:id="@+id/c_icono" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/hab_bike" android:tint="@color/virtud_coraje"/>
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/c_nombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Bicicleta 1H" android:textColor="@color/widget_texto" android:textSize="15sp" android:textStyle="bold"/>

            <TextView android:id="@+id/c_virtud" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:letterSpacing="0.08" android:maxLines="1" android:textColor="@color/virtud_coraje" android:textSize="10sp" android:textStyle="bold" android:text="CORAJE · SÍ / NO"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="end" android:orientation="vertical">

            <TextView android:id="@+id/c_racha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="XII" android:textColor="@color/widget_dorado" android:textSize="22sp" android:textStyle="bold"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="RACHA" android:textColor="@color/widget_suave" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">

            <FrameLayout android:id="@+id/c_cp0" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/cp_ok"/>

            <TextView android:id="@+id/c_bx0" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="7dp" android:layout_marginTop="5dp" android:layout_marginEnd="7dp" android:background="@drawable/dia_ok" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:text="✓" android:textColor="@color/widget_ok"/>

            <TextView android:id="@+id/c_lb0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.06" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="V"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">

            <FrameLayout android:id="@+id/c_cp1" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/cp_ok"/>

            <TextView android:id="@+id/c_bx1" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="7dp" android:layout_marginTop="5dp" android:layout_marginEnd="7dp" android:background="@drawable/dia_ok" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:text="✓" android:textColor="@color/widget_ok"/>

            <TextView android:id="@+id/c_lb1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.06" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="S"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">

            <FrameLayout android:id="@+id/c_cp2" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/cp_mal"/>

            <TextView android:id="@+id/c_bx2" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="7dp" android:layout_marginTop="5dp" android:layout_marginEnd="7dp" android:background="@drawable/dia_mal" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:text="×" android:textColor="@color/widget_miss"/>

            <TextView android:id="@+id/c_lb2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.06" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="D"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">

            <FrameLayout android:id="@+id/c_cp3" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/cp_ok"/>

            <TextView android:id="@+id/c_bx3" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="7dp" android:layout_marginTop="5dp" android:layout_marginEnd="7dp" android:background="@drawable/dia_ok" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:text="✓" android:textColor="@color/widget_ok"/>

            <TextView android:id="@+id/c_lb3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.06" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="L"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">

            <FrameLayout android:id="@+id/c_cp4" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/cp_ok"/>

            <TextView android:id="@+id/c_bx4" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="7dp" android:layout_marginTop="5dp" android:layout_marginEnd="7dp" android:background="@drawable/dia_ok" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:text="✓" android:textColor="@color/widget_ok"/>

            <TextView android:id="@+id/c_lb4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.06" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="M"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">

            <FrameLayout android:id="@+id/c_cp5" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/cp_ok"/>

            <TextView android:id="@+id/c_bx5" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="7dp" android:layout_marginTop="5dp" android:layout_marginEnd="7dp" android:background="@drawable/dia_ok" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:text="✓" android:textColor="@color/widget_ok"/>

            <TextView android:id="@+id/c_lb5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.06" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="M"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">

            <FrameLayout android:id="@+id/c_cp6" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/cp_hoy"/>

            <TextView android:id="@+id/c_bx6" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="7dp" android:layout_marginTop="5dp" android:layout_marginEnd="7dp" android:background="@drawable/dia_hoy" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:text="" android:textColor="@color/widget_ok"/>

            <TextView android:id="@+id/c_lb6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:letterSpacing="0.06" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="J"/>
        </LinearLayout>

    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_ln"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="6dp">

        <TextView android:id="@+id/c_pct" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.08" android:maxLines="1" android:textColor="@color/widget_suave" android:textSize="10sp" android:textStyle="bold" android:text="30 DÍAS · 83%"/>

        <TextView android:id="@+id/c_accion" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="2dp" android:textColor="@color/widget_dorado" android:textSize="13sp" android:textStyle="bold" android:text="Marcar hoy ◇"/>
    </LinearLayout>
</LinearLayout>