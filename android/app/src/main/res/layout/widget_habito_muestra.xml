<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa: un hábito. -->
<!-- Widget de un hábito: nombre, cómo vas hoy, racha y el rombo para marcar. --><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_fondo" android:orientation="vertical" android:padding="12dp">

