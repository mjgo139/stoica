<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa: memento mori. -->
<!-- Widget Memento mori: lo que probablemente queda, cuánto pasó y tus años como puntos. --><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_fondo" android:orientation="vertical" android:padding="14dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="MEMENTO MORI" android:textColor="@color/widget_dorado" android:textSize="11sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:baselineAligned="true" android:orientation="horizontal">

        <TextView android:id="@+id/m_numero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:maxLines="1" android:text="14.600" android:textColor="@color/widget_texto" android:textSize="28sp" android:textStyle="bold"/>

        <TextView android:id="@+id/m_unidad" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="días te quedan probablemente (hasta los 73)" android:textColor="@color/widget_suave" android:textSize="12sp"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/m_barra" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp" android:max="1000" android:progress="453" android:progressDrawable="@drawable/widget_barra_oro"/>

    <TextView android:id="@+id/m_pct" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_texto" android:textSize="12sp" android:text="45,3% de tu vida probable ya pasó"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp"/>

    <ImageView android:id="@+id/m_anios" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitStart" android:src="@drawable/memento_muestra"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp"/>

    <TextView android:id="@+id/m_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_suave" android:textSize="11sp" android:text="33 años · 1.725 semanas vividas · 2027 en 56 días"/>

    <TextView android:id="@+id/m_frase" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="serif" android:maxLines="2" android:textColor="@color/widget_suave" android:textSize="12sp" android:textStyle="italic" android:text="“No vivas como si fueras a vivir diez mil años.” — Marco Aurelio"/>
</LinearLayout>