<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa del widget Hoy (datos de ejemplo para el menú de widgets). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_fondo" android:orientation="vertical" android:padding="14dp">

    <TextView android:id="@+id/w_titulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="@string/widget_titulo" android:textColor="@color/widget_dorado" android:textSize="11sp" android:textStyle="bold"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="bottom" android:orientation="horizontal">

        <TextView android:id="@+id/w_numero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="2/3" android:textColor="@color/widget_texto" android:textSize="34sp" android:textStyle="bold"/>

        <TextView android:id="@+id/w_detalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="5dp" android:textColor="@color/widget_suave" android:textSize="13sp" android:text="hábitos"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/w_barra" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="66" android:progressDrawable="@drawable/widget_barra"/>

    <TextView android:id="@+id/w_texto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="4" android:text="Falta: Leer 20 minutos" android:textColor="@color/widget_texto" android:textSize="13sp"/>

    <!-- Espacio flexible: la frase queda siempre abajo, aproveche el widget el tamaño que tenga. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <TextView android:id="@+id/w_frase" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="serif" android:maxLines="2" android:text="Victoria sobre ti mismo." android:textColor="@color/widget_suave" android:textSize="12sp" android:textStyle="italic"/>
</LinearLayout>