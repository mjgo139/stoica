rules_version = '2';

// Reglas de Stoica. Principio: todo cerrado salvo lo que se abre explícitamente.
// - users/**: solo el dueño, con la forma de cada colección validada. El campo `rol` lo escribe solo el servidor.
//   El admin NO puede leer datos privados de nadie.
// - accounts/** y metrics/**: los lee solo el admin. El dueño solo puede tocar su último acceso.
// - catalog/** y config/**: los lee cualquiera, los escribe el admin.
// - groups/**: solo integrantes. El grupo en sí lo escribe el servidor (crear, unirse, salir).
//   Cada integrante escribe solo su resumen, sus reacciones y su progreso.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudas ----------
    function autenticado() {
      return request.auth != null;
    }
    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }
    function esAdmin() {
      return autenticado() && request.auth.token.rol == 'admin';
    }
    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function entero(v, min, max) {
      return v is int && v >= min && v <= max;
    }
    function numero(v, min, max) {
      return (v is int || v is float) && v >= min && v <= max;
    }
    function ahoraMs() {
      return request.time.toMillis();
    }
    // Fecha en milisegundos: posterior a 2023 y no más de un día en el futuro.
    // (Sin límite hacia atrás: una escritura hecha sin conexión puede llegar días después.)
    function fechaMs(v) {
      return v is int && v > 1672531200000 && v < ahoraMs() + 86400000;
    }
    function claveDia(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // Día cercano: entre ~2 años atrás y 2 días adelante. Evita llenar la base con fechas inventadas.
    function diaCercano(v) {
      return claveDia(v)
        && timestamp.date(int(v[0:4]), int(v[5:7]), int(v[8:10])) > request.time - duration.value(800, 'd')
        && timestamp.date(int(v[0:4]), int(v[5:7]), int(v[8:10])) < request.time + duration.value(2, 'd');
    }
    // Cuenta bloqueada automáticamente por abuso (claim que pone el servidor): no escribe nada.
    function noBloqueado() {
      return request.auth.token.get('bloqueado', false) != true;
    }
    function hora(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function nuevo() {
      return request.resource.data;
    }
    function cambiaron() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function firmado(uid) {
      return nuevo().actualizadoPor == uid && fechaMs(nuevo().actualizado) && noBloqueado();
    }
    function momento(v) {
      return v in [0, 1, 2];
    }
    // Minuto del día en UTC (avisos a cualquier minuto).
    function minuto(v) {
      return entero(v, 0, 1439);
    }
    function opcional(d, campo) {
      return !(campo in d) || d[campo] == null;
    }

    // ---------- Perfil ----------
    match /users/{uid} {
      function perfilValido() {
        let d = nuevo();
        return d.keys().hasOnly(['nombre', 'correo', 'tema', 'mementoMori', 'zonaHoraria', 'notificaciones', 'examenHora', 'examenSlot', 'examenMin', 'notifReacciones', 'notifCumplidos', 'notifFotos', 'notifMensajes', 'nacimiento', 'esperanzaVida', 'contadores', 'creado', 'actualizado', 'actualizadoPor', 'rol'])
          && d.keys().hasAll(['nombre', 'correo', 'tema', 'mementoMori', 'zonaHoraria', 'creado', 'actualizado', 'actualizadoPor'])
          && texto(d.nombre, 1, 40)
          && texto(d.correo, 0, 254)
          && d.tema in ['claro', 'oscuro', 'sistema']
          && d.mementoMori is bool
          && texto(d.zonaHoraria, 1, 64)
          && (!('notificaciones' in d) || d.notificaciones is bool)
          && (!('examenHora' in d) || d.examenHora == null || hora(d.examenHora))
          && (!('examenSlot' in d) || d.examenSlot == null || entero(d.examenSlot, 0, 95))
          && (opcional(d, 'examenMin') || minuto(d.examenMin))
          && (opcional(d, 'nacimiento') || claveDia(d.nacimiento))
          && (!('esperanzaVida' in d) || entero(d.esperanzaVida, 40, 120))
          && (!('contadores' in d) || (d.contadores is list && d.contadores.size() <= 5))
          && (!('notifReacciones' in d) || d.notifReacciones is bool)
          && (!('notifCumplidos' in d) || d.notifCumplidos is bool)
          && (!('notifFotos' in d) || d.notifFotos is bool)
          && (!('notifMensajes' in d) || d.notifMensajes is bool)
          && d.creado is int
          && firmado(uid);
      }

      allow read: if esDueno(uid);
      allow create: if esDueno(uid) && perfilValido() && !('rol' in nuevo()) && fechaMs(nuevo().creado);
      allow update: if esDueno(uid) && perfilValido() && !cambiaron().hasAny(['rol', 'creado', 'correo']);
      allow delete: if false;

      // ----- Hábitos -----
      match /habits/{hid} {
        function habitoValido() {
          let d = nuevo();
          return d.keys().hasOnly(['nombre', 'tipo', 'virtud', 'icono', 'momento', 'dias', 'meta', 'unidad', 'variables', 'recordatorio', 'recordatorioSlot', 'recordatorios', 'avisos', 'inicio', 'archivado', 'orden', 'racha', 'mejorRacha', 'creado', 'actualizado', 'actualizadoPor'])
            && texto(d.nombre, 1, 40)
            && d.tipo in ['sino', 'cantidad', 'medicion', 'lista']
            && d.virtud in ['sabiduria', 'coraje', 'justicia', 'templanza']
            && texto(d.icono, 1, 20)
            && momento(d.momento)
            && d.dias is list && d.dias.size() >= 1 && d.dias.size() <= 7
            && entero(d.meta, 1, 100000)
            && texto(d.unidad, 0, 16)
            && d.variables is list && d.variables.size() <= 6
            && (d.recordatorio == null || hora(d.recordatorio))
            && (d.recordatorioSlot == null || entero(d.recordatorioSlot, 0, 95))
            && (!('recordatorios' in d) || (d.recordatorios is list && d.recordatorios.size() <= 3
                && (d.recordatorios.size() < 1 || hora(d.recordatorios[0]))
                && (d.recordatorios.size() < 2 || hora(d.recordatorios[1]))
                && (d.recordatorios.size() < 3 || hora(d.recordatorios[2]))))
            && (!('avisos' in d) || (d.avisos is list && d.avisos.size() <= 3
                && (d.avisos.size() < 1 || minuto(d.avisos[0]))
                && (d.avisos.size() < 2 || minuto(d.avisos[1]))
                && (d.avisos.size() < 3 || minuto(d.avisos[2]))))
            && diaCercano(d.inicio)
            && d.archivado is bool
            && entero(d.orden, 0, 1000)
            && entero(d.racha, 0, 100000)
            && entero(d.mejorRacha, 0, 100000)
            && d.creado is int
            && firmado(uid);
        }
        allow read, delete: if esDueno(uid);
        allow create: if esDueno(uid) && habitoValido();
        allow update: if esDueno(uid) && habitoValido() && !cambiaron().hasAny(['tipo', 'creado']);
      }

      // ----- Registros diarios: logs/{habitId}_{AAAA-MM-DD} -----
      match /logs/{lid} {
        function registroValido() {
          let d = nuevo();
          return d.keys().hasOnly(['habitId', 'fecha', 'hecho', 'valor', 'medidas', 'nota', 'actualizado', 'actualizadoPor'])
            && texto(d.habitId, 1, 40)
            && diaCercano(d.fecha)
            && lid == d.habitId + '_' + d.fecha
            && d.hecho is bool
            && numero(d.valor, 0, 200000)
            && d.medidas is map && d.medidas.size() <= 6
            && texto(d.nota, 0, 500)
            && firmado(uid);
        }
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && registroValido();
      }

      // ----- Tareas -----
      match /tasks/{tid} {
        function tareaValida() {
          let d = nuevo();
          return d.keys().hasOnly(['titulo', 'dependeDeTi', 'momento', 'fecha', 'repetir', 'proyectoId', 'hora', 'avisoMin', 'completada', 'creado', 'actualizado', 'actualizadoPor'])
            && texto(d.titulo, 1, 120)
            && d.dependeDeTi is bool
            && momento(d.momento)
            && (d.fecha == null || claveDia(d.fecha))
            && d.repetir in ['no', 'diaria']
            && (opcional(d, 'proyectoId') || texto(d.proyectoId, 1, 40))
            && (opcional(d, 'hora') || hora(d.hora))
            && (opcional(d, 'avisoMin') || minuto(d.avisoMin))
            && (opcional(d, 'completada') || diaCercano(d.completada))
            && d.creado is int
            && firmado(uid);
        }
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && tareaValida();
      }

      // ----- Proyectos (agrupan tareas) -----
      match /projects/{pid} {
        function proyectoValido() {
          let d = nuevo();
          return d.keys().hasOnly(['nombre', 'virtud', 'fechaLimite', 'archivado', 'creado', 'actualizado', 'actualizadoPor'])
            && texto(d.nombre, 1, 60)
            && d.virtud in ['sabiduria', 'coraje', 'justicia', 'templanza']
            && (d.fechaLimite == null || claveDia(d.fechaLimite))
            && d.archivado is bool
            && d.creado is int
            && firmado(uid);
        }
        allow read, delete: if esDueno(uid);
        allow create: if esDueno(uid) && proyectoValido();
        allow update: if esDueno(uid) && proyectoValido() && !cambiaron().hasAny(['creado']);
      }

      // ----- Tareas hechas: taskDone/{taskId}_{fecha} -----
      match /taskDone/{did} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && nuevo().keys().hasOnly(['taskId', 'fecha', 'hecha', 'actualizado', 'actualizadoPor'])
          && texto(nuevo().taskId, 1, 40)
          && diaCercano(nuevo().fecha)
          && (!('hecha' in nuevo()) || nuevo().hecha is bool)
          && did == nuevo().taskId + '_' + nuevo().fecha
          && firmado(uid);
      }

      // ----- Enfoque -----
      match /focus/{fid} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && nuevo().keys().hasOnly(['tipo', 'minutos', 'etiqueta', 'fecha', 'inicio', 'actualizado', 'actualizadoPor'])
          && nuevo().tipo in ['enfoque', 'descanso', 'meditacion']
          && entero(nuevo().minutos, 1, 240)
          && texto(nuevo().etiqueta, 0, 60)
          && diaCercano(nuevo().fecha)
          && nuevo().inicio is int
          && firmado(uid);
      }

      // ----- Examen nocturno: journal/{fecha} -----
      match /journal/{fecha} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && nuevo().keys().hasOnly(['fecha', 'respuestas', 'libre', 'actualizado', 'actualizadoPor'])
          && diaCercano(nuevo().fecha)
          && fecha == nuevo().fecha
          && nuevo().respuestas is map
          && nuevo().respuestas.keys().hasOnly(['p1', 'p2', 'p3'])
          && texto(nuevo().respuestas.p1, 0, 1000)
          && texto(nuevo().respuestas.p2, 0, 1000)
          && texto(nuevo().respuestas.p3, 0, 1000)
          && texto(nuevo().libre, 0, 1000)
          && firmado(uid);
      }

      // ----- El Espejo: lo escribe solo el servidor (imágenes generadas) -----
      match /espejo/{doc} {
        allow read: if esDueno(uid);
        allow write: if false;
      }

      // ----- Jardín estoico: jardin/config (riego, dificultad, dónde puso macetas y adornos) -----
      match /jardin/{doc} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && doc == 'config'
          && nuevo().keys().hasOnly(['modo', 'dificil', 'riegos', 'retonosPrevios', 'fortunaEspantada', 'pos', 'adornos', 'logros', 'fuego', 'vistas', 'actualizado', 'actualizadoPor'])
          && nuevo().modo in ['auto', 'manual']
          && nuevo().dificil is bool
          && nuevo().riegos is map && nuevo().riegos.size() <= 60
          && nuevo().retonosPrevios is map && nuevo().retonosPrevios.size() <= 60
          && texto(nuevo().fortunaEspantada, 0, 40)
          && nuevo().pos is map && nuevo().pos.keys().hasOnly(['vertical', 'horizontal'])
          && nuevo().pos.get('vertical', {}).size() <= 120 && nuevo().pos.get('horizontal', {}).size() <= 120
          && nuevo().adornos is map && nuevo().adornos.keys().hasOnly(['vertical', 'horizontal'])
          && nuevo().adornos.get('vertical', {}).size() <= 40 && nuevo().adornos.get('horizontal', {}).size() <= 40
          && entero(nuevo().logros, 0, 10000)
          && texto(nuevo().fuego, 0, 20)
          && nuevo().vistas is map && nuevo().vistas.size() <= 120
          && firmado(uid);
      }

      // ----- Hitos: milestones/{habitId}_{días} -----
      match /milestones/{mid} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && nuevo().keys().hasOnly(['habitId', 'dias', 'fecha', 'actualizado', 'actualizadoPor'])
          && texto(nuevo().habitId, 1, 40)
          && entero(nuevo().dias, 1, 100000)
          && mid == nuevo().habitId + '_' + string(nuevo().dias)
          && claveDia(nuevo().fecha)
          && firmado(uid);
      }

      // ----- Marcas de borrado (para que los otros dispositivos quiten lo borrado) -----
      match /borrados/{bid} {
        allow read: if esDueno(uid);
        allow delete: if false;
        allow create, update: if esDueno(uid)
          && nuevo().keys().hasOnly(['col', 'docId', 'actualizado', 'actualizadoPor'])
          && nuevo().col in ['habits', 'tasks', 'projects']
          && texto(nuevo().docId, 1, 60)
          && bid == nuevo().col + '_' + nuevo().docId
          && firmado(uid);
      }

      // ----- Dispositivos para notificaciones -----
      match /devices/{did} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && nuevo().keys().hasOnly(['token', 'plataforma', 'actualizado', 'actualizadoPor'])
          && texto(nuevo().token, 10, 4096)
          && texto(nuevo().plataforma, 0, 20)
          && firmado(uid);
      }
    }

    // ---------- Cuentas (datos no privados para el admin) ----------
    match /accounts/{uid} {
      allow read: if esAdmin();
      // La app actualiza el último acceso una vez por día. Nada más.
      allow update: if esDueno(uid)
        && cambiaron().hasOnly(['ultimoAcceso', 'plataforma', 'actualizadoPor'])
        && fechaMs(nuevo().ultimoAcceso)
        && texto(nuevo().plataforma, 0, 40)
        && nuevo().actualizadoPor == uid;
      allow create, delete: if false;
    }

    // ---------- Métricas diarias (las calcula el servidor) ----------
    match /metrics/{fecha} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ---------- Catálogo y configuración ----------
    match /catalog/{doc=**} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /config/plan {
      allow read: if true;
      allow write: if esAdmin()
        && nuevo().keys().hasOnly(['diasGracia'])
        && entero(nuevo().diasGracia, 0, 60);
    }
    match /config/{doc=**} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---------- Plan de pago: códigos y reportes (solo el admin los lee; los escribe el servidor) ----------
    match /codigos/{c} {
      allow read: if esAdmin();
      allow write: if false;
    }
    match /reportes/{r} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // ---------- Comunidad ----------
    match /groups/{gid} {
      function miembros() {
        return get(/databases/$(database)/documents/groups/$(gid)).data.miembros;
      }
      function esMiembro() {
        return autenticado() && request.auth.uid in miembros();
      }
      function creoElGrupo() {
        return autenticado() && get(/databases/$(database)/documents/groups/$(gid)).data.creador == request.auth.uid;
      }

      // El grupo (nombre, código, integrantes) lo escribe solo el servidor.
      allow read: if autenticado() && request.auth.uid in resource.data.miembros;
      allow write: if false;

      // Resumen que cada integrante comparte (nunca valores reales de medición ni el examen).
      match /members/{mid} {
        allow read: if esMiembro();
        allow delete: if esDueno(mid);
        allow create, update: if esDueno(mid) && esMiembro()
          && nuevo().keys().hasOnly(['nombre', 'compartidos', 'jardin', 'fecha', 'actualizado', 'actualizadoPor'])
          && texto(nuevo().nombre, 0, 40)
          && nuevo().compartidos is list && nuevo().compartidos.size() <= 12
          && (!('jardin' in nuevo()) || (nuevo().jardin is map && nuevo().jardin.keys().hasOnly(['pos', 'adornos', 'logros'])))
          && claveDia(nuevo().fecha)
          && firmado(mid);
      }

      // Reacciones predefinidas: reactions/{día}_{de}_{para}. Sin texto libre.
      match /reactions/{rid} {
        allow read: if esMiembro();
        allow delete: if autenticado() && resource.data.de == request.auth.uid;
        allow create, update: if esMiembro()
          && nuevo().keys().hasOnly(['de', 'para', 'dia', 'tipo', 'nombreDe', 'actualizado', 'actualizadoPor'])
          && nuevo().de == request.auth.uid
          && nuevo().para != request.auth.uid
          && nuevo().para in miembros()
          && claveDia(nuevo().dia)
          && rid == nuevo().dia + '_' + nuevo().de + '_' + nuevo().para
          && nuevo().tipo in ['laurel', 'fuerza', 'bien', 'animo', 'calma']
          && texto(nuevo().nombreDe, 0, 40)
          && firmado(request.auth.uid);
      }

      function planActivo() {
        return get(/databases/$(database)/documents/groups/$(gid)).data.get('premiumHasta', 0) > request.time.toMillis();
      }

      // Plan de pago: foto de hoy en cada hábito compartido. Las crea solo el servidor; cada uno borra las suyas.
      match /fotos/{fid} {
        allow read: if esMiembro();
        allow create, update: if false;
        allow delete: if esMiembro() && resource.data.de == request.auth.uid;

        // Comentarios de la foto: escribe cualquier integrante con el plan activo. Borra quien comentó
        // o quien subió la foto. El contador y los avisos los maneja el servidor.
        match /comentarios/{cid} {
          function fotoDe() {
            return get(/databases/$(database)/documents/groups/$(gid)/fotos/$(fid)).data.de;
          }
          allow read: if esMiembro();
          allow create: if esMiembro() && planActivo() && noBloqueado()
            && exists(/databases/$(database)/documents/groups/$(gid)/fotos/$(fid))
            && nuevo().keys().hasOnly(['de', 'nombre', 'texto', 'dia', 'creado', 'actualizado', 'actualizadoPor'])
            && nuevo().de == request.auth.uid
            && texto(nuevo().texto, 1, 280)
            && texto(nuevo().nombre, 0, 40)
            && claveDia(nuevo().dia)
            && fechaMs(nuevo().creado)
            && firmado(request.auth.uid);
          allow update: if false;
          allow delete: if esMiembro() && (resource.data.de == request.auth.uid || fotoDe() == request.auth.uid);
        }
      }

      // Versión anterior: chat del grupo. Se reemplazó por comentarios en las fotos (el servidor lo limpia).
      match /mensajes/{mid} {
        allow read, write: if false;
      }

      // Desafíos con duración y meta.
      match /challenges/{cid} {
        function desafioValido() {
          let d = nuevo();
          return d.keys().hasOnly(['titulo', 'virtud', 'duracion', 'meta', 'inicio', 'creador', 'actualizado', 'actualizadoPor'])
            && texto(d.titulo, 1, 60)
            && d.virtud in ['sabiduria', 'coraje', 'justicia', 'templanza']
            && entero(d.duracion, 3, 365)
            && entero(d.meta, 1, d.duracion)
            && claveDia(d.inicio)
            && firmado(request.auth.uid);
        }
        allow read: if esMiembro();
        allow create: if esMiembro() && desafioValido() && nuevo().creador == request.auth.uid;
        // Quien lo creó (o quien creó el grupo) edita nombre, virtud y meta; la duración solo se alarga y el inicio no cambia.
        allow update: if esMiembro() && desafioValido() && (resource.data.creador == request.auth.uid || creoElGrupo())
          && !cambiaron().hasAny(['creador', 'inicio'])
          && nuevo().duracion >= resource.data.duracion;
        allow delete: if esMiembro() && (resource.data.creador == request.auth.uid || creoElGrupo());

        // Versión anterior: fotos y mensajes dentro del desafío. Ya no se usan (el servidor los limpia).
        match /posts/{pubId} {
          allow read, write: if false;
        }

        match /progress/{pid} {
          allow read: if esMiembro();
          allow delete: if esDueno(pid);
          allow create, update: if esDueno(pid) && esMiembro()
            && nuevo().keys().hasOnly(['nombre', 'habitId', 'cumplidos', 'habito', 'fecha', 'actualizado', 'actualizadoPor'])
            && texto(nuevo().nombre, 0, 40)
            && texto(nuevo().habitId, 1, 40)
            && entero(nuevo().cumplidos, 0, 365)
            && (opcional(nuevo(), 'habito') || (nuevo().habito is map && nuevo().habito.size() <= 10))
            && (opcional(nuevo(), 'fecha') || claveDia(nuevo().fecha))
            && firmado(pid);
        }
      }
    }
  }
}
